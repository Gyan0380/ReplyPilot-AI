rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profile protection
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null 
                    && request.auth.uid == uid 
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['plan', 'dailyLimit', 'expiry', 'premium', 'admin']);
      allow delete: if false;
      
      // Usage is readable by user, but strictly written by the Server API
      match /usage/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; 
      }
    }

    // Keys collection (Only Admins)
    match /keys/{keyId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
  }
}
